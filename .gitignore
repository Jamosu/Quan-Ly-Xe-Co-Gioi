# ==========================================
# THACO AGRI Fleet Management - .gitignore
# ==========================================

# --- Excluded non-code / documentation / database folders ---
# database/
!database/production_data_dump.sql
!database/python_scripts/
# Keep the shared AI project memory under source control while leaving ad-hoc
# generated documentation ignored by default.
docs/*
!docs/README.md
!docs/architecture/
!docs/architecture/*.md
!docs/business/
!docs/business/*.md
!docs/development/
!docs/development/*.md
!docs/decisions/
!docs/decisions/*.md
legacy_mockup/
Logs/
logs/
scratch/
.tmp_brd_review/
.android-toolchain/

# --- Temporary export / scratch scripts ---
export_mockup_pdf.js
generate_image_only_pdf.js
*.pdf
*.xlsx
*.xls
*.csv
*.sql
!database/production_data_dump.sql
!backend/prisma/production_data_dump.sql
!backend/prisma/migrations/20260916110000_sos_rescue_dispatch/migration.sql
!backend/prisma/migrations/**/migration.sql
*.sqlite
*.sqlite-journal
*.apk
*.aab
releases/

# --- Dependencies ---
node_modules/
.pnpm-store/
package-lock.json.bak

# --- Builds and dist ---
dist/
build/
out/
graphify-out/*
!graphify-out/.gitkeep
.next/
*.tsbuildinfo
vite.config.ts.timestamp-*

# --- Environment files ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Logs and debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE / OS files ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Mobile / Expo / Native build outputs ---
.expo/
web-build/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.mobileprovision
.metro-health-check*
/ios/
/android/
