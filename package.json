{
  "name": "thaco-agri-fleet-mockup",
  "version": "1.0.0",
  "description": "THACO AGRI Fleet Management System - Modern React SPA & Mockup Platform",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "db:generate": "npm run prisma:generate --prefix backend",
    "import:vehicles": "npm run import:vehicles --prefix backend",
    "start:backend": "npm run start:prod --prefix backend"
  },
  "devDependencies": {
    "vite": "^5.4.21"
  }
}
