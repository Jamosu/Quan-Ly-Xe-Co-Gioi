generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (PHÂN LOẠI & TRẠNG THÁI NGHIỆP VỤ)
// ==========================================

enum Role {
  SUPER_ADMIN
  DISPATCHER
  FARM_MANAGER
  WORKSHOP_MANAGER
  FUEL_STOREKEEPER
  DRIVER
}

enum Unit {
  NT1
  NT2
  XN_BO
  TT_BTSC
  BAN_CO_GIOI
  TOAN_KLH
}

enum DriverEmploymentStatus {
  DANG_LAM_VIEC // Còn làm việc
  DA_NGHI_VIEC // Đã nghỉ việc / Chấm dứt HĐLĐ
}

enum DriverShiftStatus {
  DANG_VAN_HANH // Đang lái máy / Chạy ca (Được giao việc)
  SAN_SANG // Sẵn sàng nhận lệnh (Chờ phân công)
  NGHI_PHEP_CA // Nghỉ phép ca / Nghỉ luân phiên
}

enum DriverLicenseClass {
  BANG_MAY_NONG_NGHIEP // Bằng máy nông nghiệp (Máy kéo, Máy gặt)
  HANG_C // Bằng C (Xe tải >3.5T)
  HANG_FC // Bằng FC (Đầu kéo Container 40ft)
  HANG_B2 // Bằng B2 (Xe bán tải)
  HANG_D // Bằng D (Xe chở người)
}

enum VehicleCategory {
  // Nhóm 1 - Máy công trình
  MAY_DAO
  MAY_UI
  MAY_SAN
  MAY_LU
  MAY_XUC_LAT
  XE_XUC

  // Nhóm 2 - Máy nông nghiệp
  MAY_CAY
  MAY_KEO
  MAY_GAT_DAP

  // Nhóm 3 - Xe vận tải & Công vụ
  XE_TAI
  XE_BEN
  XE_BON
  XE_CONTAINER
  XE_BAN_TAI
  XE_CHUYEN_DUNG
  XE_CONG_VU
  XE_CHO_NGUOI

  // Nhóm 4 - Máy móc & Thiết bị phụ trợ
  XE_NANG
  MAY_PHAT_DIEN
  MAY_PHAT_CO
  MAY_CUA
  MAY_BOM
  XE_MAY_2_BANH
  THIET_BI_NONG_CU
}

enum FuelQuotaUnit {
  L_PER_HOUR // Lít / Giờ máy (L/h)
  L_PER_KM // Lít / 100km (L/100km)
  L_PER_HA // Lít / Ha (L/ha)
}

enum VehicleStatus {
  HOAT_DONG
  TAM_DUNG
  BAO_DUONG
  SUA_CHUA
  CHO_PHAN_CONG
}

enum MaintenanceAlertTier {
  GREEN // An toàn (0 - 200h)
  AMBER // Sắp đến hạn (200 - 250h)
  RED // Quá hạn bảo dưỡng (> 250h)
}

enum ImplementCategory {
  DAN_CAY
  DAN_BUA
  DAN_XOI
  DAN_RAI_PHAN
  RO_MOOC
  DAN_PHUN_THUOC
}

enum ImplementStatus {
  ATTACHED
  IN_DEPOT
  MAINTENANCE
}

enum TechnicalCondition {
  GOOD
  WORN_OUT
  NEED_REPAIR
}

enum ProductionStage {
  LAM_DAT // Giai đoạn 1: Làm đất (Cày sâu 30cm, Bừa đĩa, Xới tơi, Lên luống)
  TRONG_MOI // Giai đoạn 2: Trồng mới (Đào hố, Bón lót, Đặt giống, Lắp tưới)
  THU_HOACH // Giai đoạn 3: Thu hoạch (Cắt buồng, Kéo cáp, Gom mooc)
  VAN_CHUYEN // Giai đoạn 4: Vận chuyển nội bộ
  HAU_CAN // Giai đoạn 5: Hậu cần & Khác
}

enum PlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  ADJUSTED
  CANCELLED
}

enum PlotStatus {
  CHUA_THUC_HIEN
  DANG_THUC_HIEN
  HOAN_THANH
}

enum DispatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ASSIGNED
  DRIVER_ACCEPTED
  DEPARTED
  WORKING
  COMPLETED
  ACCEPTED
  CLOSED
  REJECTED
  CANCELLED
}

enum RouteType {
  ONE_WAY
  TWO_WAY
}

enum TransportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ASSIGNED
  DRIVER_ACCEPTED
  AT_PICKUP
  LOADING
  DEPARTED
  IN_TRANSIT
  AT_DELIVERY
  UNLOADING
  DELIVERED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum DispatchSourceType {
  MANUAL
  PRODUCTION_ORDER
  IMPORT
}

enum TransportFlowType {
  STANDARD
  LIVESTOCK_FEED_3_LEG
}

enum OperationalEntityType {
  VEHICLE
  VEHICLE_DRIVER_ASSIGNMENT
  DRIVER_UNAVAILABILITY
  VEHICLE_UNAVAILABILITY
  MAINTENANCE
  REPAIR
  WORK_ORDER
  PRODUCTION_PLAN
  PRODUCTION_ORDER
  DISPATCH_ORDER
  TRANSPORT_ORDER
  OPERATION_CONFIRMATION
}

enum OperationConfirmationType {
  WEIGHT
  GPS
}

enum OperationConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TransportImportStatus {
  COMMITTED
  FAILED
}

enum ReturnDriverStatus {
  EMPTY_DISPATCHED
  RETURN_LOADED
  RETURN_DELIVERED
}

enum FeedGroupType {
  PHU_PHAM_CHUOI
  CO_VOI
  TMR_VO_BEO
  BA_BIA
  CAM_VIEN
  KHOANG_PREMIX
}

enum SlaStatus {
  ON_TIME
  DELAYED
}

enum WarehouseType {
  STATIONARY_TANK_45000L // Bồn cố định 45.000L Trung tâm
  MOBILE_TRUCK_5000L // Xe bồn lưu động 5.000L
}

enum MaintenanceStatus {
  SCHEDULED
  IN_SERVICE
  COMPLETED
}

enum RepairTier {
  TIEU_TU
  TRUNG_TU
  DAI_TU
  SOS_CUU_HO
}

enum RepairStatus {
  RECEIVED
  IN_REPAIR
  WAITING_PARTS
  COMPLETED
}

enum KpiGrade {
  HANG_A // Xuất sắc (>= 90đ)
  HANG_B // Đạt chuẩn (75 - 89đ)
  HANG_C // Cần cải thiện (50 - 74đ)
  HANG_D // Yếu kém (< 50đ)
}

enum SosEmergencyType {
  HONG_MAY
  THUNG_LOP
  SA_LAY_RUONG
  TAI_NAN
  HET_DAU_DOT_XUAT
}

enum SosStatus {
  PENDING
  DISPATCHED
  RESOLVED
}

enum VehicleDriverAssignmentType {
  PRIMARY
  SECONDARY
  TEMPORARY
}

enum VehicleDriverAssignmentStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum WorkOrderType {
  DISPATCH
  TRANSPORT
  INTERNAL_FEED
}

enum WorkAssignmentMode {
  FIXED_ASSIGNMENT
  OPEN_ASSIGNMENT
}

enum WorkOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  OPEN_FOR_CLAIM
  ASSIGNED
  DRIVER_ACCEPTED
  IN_PROGRESS
  SUBMITTED_FOR_ACCEPTANCE
  REWORK_REQUIRED
  ACCEPTED
  CLOSED
  REJECTED
  CANCELLED
}

enum WorkAssignmentStatus {
  ASSIGNED
  ACCEPTED
  CANNOT_ACCEPT
  REASSIGNED
  COMPLETED
  CANCELLED
}

enum UnavailabilityStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DriverUnavailabilityType {
  LEAVE
  SHIFT_REST
  MEDICAL
  EMERGENCY
  OTHER
}

enum VehicleUnavailabilityType {
  BREAKDOWN
  MANUAL_HOLD
  INSPECTION
  OTHER
}

enum WorkEvidenceType {
  START_PHOTO
  COMPLETION_PHOTO
  ACCEPTANCE_PHOTO
  CANNOT_ACCEPT_EVIDENCE
  OTHER
}

enum WorkAcceptanceStatus {
  PENDING
  APPROVED
  REWORK_REQUIRED
}

enum DriverKpiEventType {
  ASSIGNED
  ACCEPTED
  CANNOT_ACCEPT
  EXECUTION_COMPLETED
  REASSIGNED
  ACCEPTANCE_APPROVED
}

enum KpiDecision {
  UNDECIDED
  EXEMPT
  COUNTED
}

// ==========================================
// 2. DATA MODELS (CẤU TRÚC BẢNG DỮ LIỆU)
// ==========================================

model User {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique // Mã nhân sự / Mã TX: TX-NT1-001, CB-KLH-01
  username              String                 @unique
  passwordHash          String
  fullName              String
  phone                 String?
  role                  Role                   @default(DRIVER)
  unit                  Unit                   @default(NT1)
  employmentStatus      DriverEmploymentStatus @default(DANG_LAM_VIEC)
  joinedDate            DateTime               @default(now()) // Ngày gia nhập để tính thâm niên
  resignedDate          DateTime? // Ngày nghỉ việc (nếu DA_NGHI_VIEC)
  resignedReason        String?                @db.Text
  licenseClass          DriverLicenseClass?    @default(BANG_MAY_NONG_NGHIEP)
  licenseNumber         String?
  licenseExpiryDate     DateTime?
  healthCheckExpiryDate DateTime?
  currentShiftStatus    DriverShiftStatus?     @default(SAN_SANG)
  currentLocation       String?                @default("Bãi Xe Trung Tâm")
  assignedVehicleId     Int?
  avatarUrl             String?                @db.Text
  isActive              Boolean                @default(true)
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Quan hệ
  assignedVehicle      Vehicle?                 @relation("UserAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  drivenVehicles       Vehicle[]                @relation("DefaultDriver")
  secondaryVehicles    Vehicle[]                @relation("SecondaryDriver")
  implementLogs        ImplementAttachmentLog[] @relation("ActorLogs")
  productionPlans      ProductionPlan[]         @relation("SupervisorPlans")
  plotProgresses       ProductionPlotProgress[] @relation("DriverPlots")
  auditTrails          ProductionAuditTrail[]   @relation("AuditActor")
  productionPlansCreated ProductionPlan[]        @relation("ProductionPlanCreator")
  productionPlansApproved ProductionPlan[]       @relation("ProductionPlanApprover")
  productionOrdersCreated ProductionOrder[]      @relation("ProductionOrderCreator")
  dispatchOrdersReq    DispatchOrder[]          @relation("RequesterDispatch")
  dispatchOrdersDriven DispatchOrder[]          @relation("DriverDispatch")
  dispatchOrdersApproved DispatchOrder[]         @relation("DispatchApprover")
  dispatchOrdersAssigned DispatchOrder[]         @relation("DispatchAssigner")
  dispatchOrdersAccepted DispatchOrder[]         @relation("DispatchAcceptor")
  transportOrders      TransportOrder[]         @relation("DriverTransport")
  transportOrdersApproved TransportOrder[]       @relation("TransportApprover")
  operationalAuditLogs OperationalAuditLog[]     @relation("OperationalAuditActor")
  operationConfirmationsCreated OperationConfirmation[] @relation("ConfirmationCreator")
  operationConfirmationsConfirmed OperationConfirmation[] @relation("ConfirmationConfirmer")
  transportImportBatches TransportImportBatch[]  @relation("TransportImportActor")
  feedTrips            InternalFeedTrip[]       @relation("DriverFeedTrip")
  feedMaterialsCreated FeedRawMaterial[]        @relation("MaterialCreator")
  fuelTicketsOperated  FuelDispenseTicket[]     @relation("OperatorTicket")
  fuelTicketsReceived  FuelDispenseTicket[]     @relation("DriverFuelTicket")
  maintenanceRecords   MaintenanceRecord[]      @relation("TechnicianMaintenance")
  repairsReported      RepairTicket[]           @relation("DriverRepairs")
  repairsAssigned      RepairTicket[]           @relation("TechnicianRepairs")
  kpis                 DriverKpi[]              @relation("DriverKpiRel")
  sosAlerts            DriverSosAlert[]         @relation("DriverSosRel")
  driverProfile        DriverProfile?
  vehicleDriverAssignmentsCreated VehicleDriverAssignment[] @relation("VehicleDriverAssignmentActor")
  driverUnavailabilityApprovals DriverUnavailability[] @relation("DriverUnavailabilityApprover")
  vehicleUnavailabilityCreated VehicleUnavailability[] @relation("VehicleUnavailabilityActor")
  workOrdersCreated    OperationalWorkOrder[] @relation("WorkOrderCreator")
  workOrdersApproved   OperationalWorkOrder[] @relation("WorkOrderApprover")
  workAssignmentsCreated WorkDriverAssignment[] @relation("WorkDriverAssignmentActor")
  workVehicleAssignmentsCreated WorkVehicleAssignment[] @relation("WorkVehicleAssignmentActor")
  workAcceptancesReviewed WorkAcceptance[] @relation("WorkAcceptanceReviewer")
  workOrderEvents      WorkOrderEvent[] @relation("WorkOrderEventActor")
  workEvidenceCreated  WorkEvidence[]

  @@index([role])
  @@index([unit])
  @@index([employmentStatus])
  @@index([currentShiftStatus])
  @@map("users")
}

model VehicleType {
  id                      Int              @id @default(autoincrement())
  code                    String           @unique
  name                    String
  assetGroup              String?
  category                VehicleCategory?
  parentId                Int?
  defaultMaintenanceHours Float            @default(250)
  defaultFuelQuotaRate    Float?
  defaultFuelQuotaUnit    FuelQuotaUnit?
  requiredLicenseClass    DriverLicenseClass?
  active                  Boolean          @default(true)
  description             String?          @db.Text
  sourceLabels            Json?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  parent   VehicleType?  @relation("VehicleTypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children VehicleType[] @relation("VehicleTypeHierarchy")
  vehicles Vehicle[]
  productionPlanItems ProductionPlanItem[]

  @@index([assetGroup])
  @@index([category])
  @@index([parentId])
  @@index([active])
  @@map("vehicle_types")
}

model VehicleManufacturer {
  id           Int      @id @default(autoincrement())
  name         String   @unique // Tên chuẩn (THACO AGRI, KOMATSU, CATERPILLAR...)
  aliases      Json?    // Danh sách alias đã biết (["THACO", "THACOAGRI"])
  countryCode  String?  // ISO 3166-1 alpha-2 (VN, JP, KR, CN...)
  countryName  String?  // Tên quốc gia tiếng Việt (VIỆT NAM, NHẬT BẢN...)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models   VehicleModel[]
  vehicles Vehicle[]

  @@index([countryCode])
  @@index([active])
  @@map("vehicle_manufacturers")
}

model VehicleModel {
  id              Int      @id @default(autoincrement())
  name            String   // Tên model (SK200-08, 6140B, HD270...)
  manufacturerId  Int
  categoryHint    VehicleCategory? // Gợi ý loại xe (nếu model chỉ dùng cho 1 loại)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manufacturer VehicleManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@unique([name, manufacturerId])
  @@index([manufacturerId])
  @@index([active])
  @@map("vehicle_models")
}

model Vehicle {
  id                Int             @id @default(autoincrement())
  code              String          @unique // Mã MMTB mới (TT, Mã MMTB mới)
  oldCode           String? // Mã MMTB cũ
  bravoCode         String? // Mã Bravo
  plate             String? // Biển số xe
  purchaseCondition String? // Tình trạng mua (Mua mới / ĐQSD...)
  name              String // Tên MMTB
  category          VehicleCategory
  vehicleTypeId     Int?
  assetGroup        String?
  vehicleSubtype    String?
  unit              Unit            @default(BAN_CO_GIOI)
  complexCode       String          @default("KOUN_MOM")
  assignedUnitCode  String? // Đơn vị sử dụng (CGTC DP, XN Chuối DP1...)
  regionCode        String? // Khu vực (DP, LP, AD, KLH)
  allocationDate    DateTime? // Ngày phân bổ
  conditionStatus   String? // Tình trạng (Bình thường / Hỏng...)
  transferHistory   String?         @db.Text // Lịch sử điều chuyển
  manufacturer      String? // NHÃN HIỆU (KOBELCO, SUMITOMO, HOWO, HINO...)
  origin            String? // XUẤT XỨ (NHẬT BẢN, HÀN QUỐC, TRUNG QUỐC, MỸ...)
  manufactureYear   Int? // NĂM SX
  modelName         String? // MODEL (SK200-08, 6140B, HD270...)
  powerHp           String? // CÔNG SUẤT (140HP, 150 KW, 110cc...)
  frameNumber       String? // Số khung
  engineNumber      String? // Số máy
  fuelQuotaRate     Float? // Định mức nhiên liệu (l/h) hoặc (l/km)
  fuelQuotaUnit     FuelQuotaUnit   @default(L_PER_HOUR)
  fuelTankCapacity  Float? // Dung tích thùng nhiên liệu (lít)
  supplier          String? // NHÀ CUNG CẤP
  notes             String?         @db.Text // Ghi chú
  imageUrl          String?         @db.Text // Hình ảnh MMTB
  technicalSpecs    String?         @db.Text
  dimensions        String?
  productivity      String?

  // Master Data FK (optional, backfill từ raw fields)
  manufacturerRefId Int? // FK → VehicleManufacturer
  modelRefId        Int? // FK → VehicleModel

  // Kế toán & Pháp nhân
  assetCode            String? // Mã tài sản kế toán
  contractStatus       String? // Tình trạng hợp đồng / tài sản
  companyOwner         String? // Pháp nhân sở hữu (THACO AGRI...)
  inspectionDate       DateTime?
  inspectionExpiryDate DateTime? // Hạn đăng kiểm (theo luật Campuchia)
  nextInspectionDate   DateTime?
  roadFeeDate          DateTime?
  roadFeeExpiryDate    DateTime?
  nextRoadFeeDate      DateTime?
  sourceSheets         Json?
  importMetadata       Json?

  defaultDriverId       Int?
  secondaryDriverId     Int?
  status                VehicleStatus        @default(CHO_PHAN_CONG)
  totalMachineHours     Float                @default(0)
  hoursSinceLastService Float                @default(0) // 0-250h
  alertTier             MaintenanceAlertTier @default(GREEN)
  odoKm                 Float                @default(0)
  fuelRateStandard      Float                @default(12.5) // L/h hoặc L/100km

  // GPS Sensor - để trống/optional, sẵn sàng gán sau
  gpsImei             String?
  fuelSensorImei      String?
  currentLat          Float?    @default(13.5678)
  currentLng          Float?    @default(106.8901)
  currentLocationName String?   @default("Khu liên hợp Koun Mom")
  lastGpsUpdate       DateTime?
  managerName         String?   // Nhân sự quản lý (từ sheet XE & MÁY CG AGRI)
  managerPhone        String?   // Số liên lạc / Zalo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ
  vehicleType        VehicleType?             @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  manufacturerRef    VehicleManufacturer?     @relation(fields: [manufacturerRefId], references: [id], onDelete: SetNull)
  modelRef           VehicleModel?            @relation(fields: [modelRefId], references: [id], onDelete: SetNull)
  defaultDriver      User?                    @relation("DefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)
  secondaryDriver    User?                    @relation("SecondaryDriver", fields: [secondaryDriverId], references: [id], onDelete: SetNull)
  assignedUsers      User[]                   @relation("UserAssignedVehicle")
  currentImplements  AgriculturalImplement[]  @relation("VehicleImplement")
  implementLogs      ImplementAttachmentLog[]
  plotProgresses     ProductionPlotProgress[]
  dispatchOrders     DispatchOrder[]
  transportOrders    TransportOrder[]
  feedTrips          InternalFeedTrip[]
  fuelTickets        FuelDispenseTicket[]
  maintenanceRecords MaintenanceRecord[]
  owedPartNotes      WorkshopOwedPartNote[]
  repairTickets      RepairTicket[]
  sosAlerts          DriverSosAlert[]
  driverAssignments  VehicleDriverAssignment[]
  workAssignments    WorkVehicleAssignment[]
  executionSegments  WorkExecutionSegment[]
  unavailability     VehicleUnavailability[]

  @@index([category])
  @@index([vehicleTypeId])
  @@index([assetGroup])
  @@index([unit])
  @@index([complexCode])
  @@index([status])
  @@index([alertTier])
  @@index([plate])
  @@index([bravoCode])
  @@index([oldCode])
  @@index([assetCode])
  @@index([assignedUnitCode])
  @@index([regionCode])
  @@index([manufacturer])
  @@index([modelName])
  @@index([manufactureYear])
  @@index([manufacturerRefId])
  @@index([modelRefId])
  @@map("vehicles")
}

model AgriculturalImplement {
  id                 Int                @id @default(autoincrement())
  code               String             @unique // TB-DC-04, TB-BD-12, TB-RP-02
  name               String // Dàn cày 4 chảo Kubota, Dàn bừa đĩa 24 chảo
  category           ImplementCategory
  unit               Unit
  currentVehicleId   Int?
  status             ImplementStatus    @default(IN_DEPOT)
  technicalCondition TechnicalCondition @default(GOOD)
  standardPurpose    String? // Cày lật đất sâu 30cm, Phay xới đất tơi xốp
  attachedAt         DateTime?
  managerName        String? // Nhân sự quản lý (Nguyễn Tấn Triều...)
  gatheringLocation  String? // Địa chỉ / Nơi tập kết (Lô 85 DP4, LP3.5-LP3...)
  managerPhone       String? // Số liên lạc (Zalo)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Quan hệ
  currentVehicle Vehicle?                 @relation("VehicleImplement", fields: [currentVehicleId], references: [id], onDelete: SetNull)
  attachmentLogs ImplementAttachmentLog[]
  dispatchOrders DispatchOrder[]
  transportOrders TransportOrder[]

  @@index([category])
  @@index([unit])
  @@index([status])
  @@map("agricultural_implements")
}

model ImplementAttachmentLog {
  id          Int       @id @default(autoincrement())
  vehicleId   Int
  implementId Int
  actorId     Int
  attachedAt  DateTime  @default(now())
  detachedAt  DateTime?
  startWearMm Float     @default(0) // Độ mòn lúc bắt đầu (mm)
  endWearMm   Float? // Độ mòn khi tháo ra (mm)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  // Quan hệ
  vehicle   Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  implement AgriculturalImplement @relation(fields: [implementId], references: [id], onDelete: Cascade)
  actor     User                  @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([implementId])
  @@index([actorId])
  @@map("implement_attachment_logs")
}

model ProductionPlan {
  id                    Int             @id @default(autoincrement())
  code                  String          @unique // KH-2026-NT1-008
  title                 String // Kế hoạch làm đất vụ Chuối 2026 - NT1
  stage                 ProductionStage @default(LAM_DAT)
  unit                  Unit            @default(NT1)
  lotPlot               String // Lô A01-A04, Khoảnh 4
  targetAreaHa          Float           @default(0)
  completedAreaHa       Float           @default(0)
  assignedVehiclesCount Int             @default(0)
  fuelQuotaLiters       Float           @default(0)
  fuelUsedLiters        Float           @default(0)
  supervisorId          Int?
  startDate             DateTime
  endDate               DateTime
  weekStart             DateTime?
  weekNumber            Int?
  complexCode           String          @default("KOUN_MOM")
  complexName           String?
  enterpriseCode        String?
  enterpriseName        String?
  farmCode              String?
  farmName              String?
  notes                 String?         @db.Text
  createdById           Int?
  approvedById          Int?
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  status                PlanStatus      @default(DRAFT)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Quan hệ
  supervisor     User?                    @relation("SupervisorPlans", fields: [supervisorId], references: [id], onDelete: SetNull)
