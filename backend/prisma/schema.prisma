// ==========================================
// 2. DATA MODELS (CẤU TRÚC BẢNG DỮ LIỆU)
// ==========================================

model User {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique // Mã nhân sự / Mã TX: TX-NT1-001, CB-KLH-01
  username              String                 @unique
  passwordHash          String
  fullName              String
  phone                 String?
  role                  Role                   @default(DRIVER)
  unit                  Unit                   @default(KOUN_MOM)
  employmentStatus      DriverEmploymentStatus @default(DANG_LAM_VIEC)
  joinedDate            DateTime               @default(now()) // Ngày gia nhập để tính thâm niên
  resignedDate          DateTime? // Ngày nghỉ việc (nếu DA_NGHI_VIEC)
  resignedReason        String?                @db.Text
  licenseClass          DriverLicenseClass?    @default(HANG_B2)
  licenseNumber         String?
  licenseExpiryDate     DateTime?
  healthCheckExpiryDate DateTime?
  currentShiftStatus    DriverShiftStatus?     @default(SAN_SANG)
  currentLocation       String?                @default("Bãi Xe Trung Tâm")
  assignedVehicleId     Int?
  avatarUrl             String?                @db.Text
  isActive              Boolean                @default(true)
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Quan hệ
  assignedVehicle                      Vehicle?                          @relation("UserAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  drivenVehicles                       Vehicle[]                         @relation("DefaultDriver")
  secondaryVehicles                    Vehicle[]                         @relation("SecondaryDriver")
  implementLogs                        ImplementAttachmentLog[]          @relation("ActorLogs")
  productionPlans                      ProductionPlan[]                  @relation("SupervisorPlans")
  plotProgresses                       ProductionPlotProgress[]          @relation("DriverPlots")
  auditTrails                          ProductionAuditTrail[]            @relation("AuditActor")
  productionPlansCreated               ProductionPlan[]                  @relation("ProductionPlanCreator")
  productionPlansApproved              ProductionPlan[]                  @relation("ProductionPlanApprover")
  productionOrdersCreated              ProductionOrder[]                 @relation("ProductionOrderCreator")
  dispatchOrdersReq                    DispatchOrder[]                   @relation("RequesterDispatch")
  dispatchOrdersDriven                 DispatchOrder[]                   @relation("DriverDispatch")
  dispatchOrdersApproved               DispatchOrder[]                   @relation("DispatchApprover")
  dispatchOrdersAssigned               DispatchOrder[]                   @relation("DispatchAssigner")
  dispatchOrdersAccepted               DispatchOrder[]                   @relation("DispatchAcceptor")
  transportOrders                      TransportOrder[]                  @relation("DriverTransport")
  transportOrdersApproved              TransportOrder[]                  @relation("TransportApprover")
  operationalAuditLogs                 OperationalAuditLog[]             @relation("OperationalAuditActor")
  operationConfirmationsCreated        OperationConfirmation[]           @relation("ConfirmationCreator")
  operationConfirmationsConfirmed      OperationConfirmation[]           @relation("ConfirmationConfirmer")
  transportImportBatches               TransportImportBatch[]            @relation("TransportImportActor")
  feedTrips                            InternalFeedTrip[]                @relation("DriverFeedTrip")
  feedMaterialsCreated                 FeedRawMaterial[]                 @relation("MaterialCreator")
  fuelTicketsOperated                  FuelDispenseTicket[]              @relation("OperatorTicket")
  fuelTicketsReceived                  FuelDispenseTicket[]              @relation("DriverFuelTicket")
  maintenanceRecords                   MaintenanceRecord[]               @relation("TechnicianMaintenance")
  maintenanceStandardsCreated          MaintenanceStandard[]             @relation("MaintenanceStandardCreator")
  maintenanceStandardsUpdated          MaintenanceStandard[]             @relation("MaintenanceStandardUpdater")
  bdc1Logs                             Bdc1Log[]                         @relation("Bdc1Performer")
  repairsReported                      RepairTicket[]                    @relation("DriverRepairs")
  repairsAssigned                      RepairTicket[]                    @relation("TechnicianRepairs")
  workshopRequestsReported             WorkshopRequest[]                 @relation("WorkshopRequestReporter")
  workshopRequestsAssigned             WorkshopRequest[]                 @relation("WorkshopRequestTechnician")
  alertReadReceipts                    AlertReadReceipt[]
  alertEventsHandled                   AlertEvent[]                      @relation("AlertHandler")
  alertEventsAsDriver                  AlertEvent[]                      @relation("AlertDriver")
  alertRulesUpdated                    AlertRule[]                       @relation("AlertRuleUpdater")
  kpis                                 DriverKpi[]                       @relation("DriverKpiRel")
  sosAlerts                            DriverSosAlert[]                  @relation("DriverSosRel")
  driverProfile                        DriverProfile?
  vehicleDriverAssignmentsCreated      VehicleDriverAssignment[]         @relation("VehicleDriverAssignmentActor")
  driverUnavailabilityApprovals        DriverUnavailability[]            @relation("DriverUnavailabilityApprover")
  vehicleUnavailabilityCreated         VehicleUnavailability[]           @relation("VehicleUnavailabilityActor")
  workOrdersCreated                    OperationalWorkOrder[]            @relation("WorkOrderCreator")
  workOrdersApproved                   OperationalWorkOrder[]            @relation("WorkOrderApprover")
  workAssignmentsCreated               WorkDriverAssignment[]            @relation("WorkDriverAssignmentActor")
  workVehicleAssignmentsCreated        WorkVehicleAssignment[]           @relation("WorkVehicleAssignmentActor")
  workAcceptancesReviewed              WorkAcceptance[]                  @relation("WorkAcceptanceReviewer")
  workOrderEvents                      WorkOrderEvent[]                  @relation("WorkOrderEventActor")
  workEvidenceCreated                  WorkEvidence[]
  workDailyProgressReports             WorkDailyProgress[]               @relation("WorkDailyProgressReporter")
  dailyReportsSubmitted                DailyReport[]                     @relation("DailyReportSubmitter")
  dailyReportsForDriver                DailyReport[]                     @relation("DailyReportDriver")
  workCompletionReports                OperationalWorkOrder[]            @relation("WorkCompletionReporter")
  workCompletionApprovals              OperationalWorkOrder[]            @relation("WorkCompletionApprover")
  mobileSessions                       MobileSession[]
  mobileSyncEvents                     MobileSyncEvent[]
  driverManagementAssignmentsMade      DriverManagementAssignment[]      @relation("DriverManagementAssignmentActor")
  driverManagementScopes               DriverManagementAccessScope[]     @relation("DriverManagementScopeUser")
  driverManagementScopesGranted        DriverManagementAccessScope[]     @relation("DriverManagementScopeGrantor")
  managementUnitManagerAssignments     ManagementUnitManagerAssignment[] @relation("ManagementUnitManager")
  managementUnitManagerAssignmentsMade ManagementUnitManagerAssignment[] @relation("ManagementUnitManagerActor")

  @@index([role])
  @@index([unit])
  @@index([employmentStatus])
  @@index([currentShiftStatus])
  @@map("users")
}

model VehicleType {
  id                      Int                       @id @default(autoincrement())
  code                    String                    @unique
  name                    String
  assetGroup              String?
  category                VehicleCategory?
  parentId                Int?
  defaultMaintenanceHours Float                     @default(250)
  defaultFuelQuotaRate    Float?
  defaultFuelQuotaUnit    FuelQuotaUnit?
  requiredLicenseClass    DriverLicenseClass?
  operationalDomain       VehicleOperationalDomain?
  implementRequirement    ImplementRequirement      @default(NONE)
  isAssignable            Boolean                   @default(true)
  active                  Boolean                   @default(true)
  description             String?                   @db.Text
  sourceLabels            Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  parent                   VehicleType?                        @relation("VehicleTypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                 VehicleType[]                       @relation("VehicleTypeHierarchy")
  vehicles                 Vehicle[]
  productionPlanItems      ProductionPlanItem[]
  requestedWorkOrders      OperationalWorkOrder[]              @relation("RequestedVehicleType")
  implementCompatibilities ImplementVehicleTypeCompatibility[]
  maintenanceStandards     MaintenanceStandard[]

  @@index([assetGroup])
  @@index([category])
  @@index([parentId])
  @@index([active])
  @@index([operationalDomain, isAssignable])
  @@map("vehicle_types")
}

model VehicleManufacturer {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Tên chuẩn (THACO AGRI, KOMATSU, CATERPILLAR...)
  aliases     Json? // Danh sách alias đã biết (["THACO", "THACOAGRI"])
  countryCode String? // ISO 3166-1 alpha-2 (VN, JP, KR, CN...)
  countryName String? // Tên quốc gia tiếng Việt (VIỆT NAM, NHẬT BẢN...)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models   VehicleModel[]
  vehicles Vehicle[]

  @@index([countryCode])
  @@index([active])
  @@map("vehicle_manufacturers")
}

model VehicleModel {
  id             Int              @id @default(autoincrement())
  name           String // Tên model (SK200-08, 6140B, HD270...)
  manufacturerId Int
  categoryHint   VehicleCategory? // Gợi ý loại xe (nếu model chỉ dùng cho 1 loại)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  manufacturer VehicleManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@unique([name, manufacturerId])
  @@index([manufacturerId])
  @@index([active])
  @@map("vehicle_models")
}

model Vehicle {
  id                Int             @id @default(autoincrement())
  code              String          @unique // Mã MMTB mới (TT, Mã MMTB mới)
  oldCode           String? // Mã MMTB cũ
  bravoCode         String? // Mã Bravo
  plate             String? // Biển số xe
  purchaseCondition String? // Tình trạng mua (Mua mới / ĐQSD...)
  name              String // Tên MMTB
  category          VehicleCategory
  vehicleTypeId     Int?
  assetGroup        String?
  vehicleSubtype    String?
  unit              Unit            @default(KOUN_MOM)
  complexCode       String          @default("KOUN_MOM")
  assignedUnitCode  String? // Đơn vị sử dụng (CGTC DP, XN Chuối DP1...)
  managementUnitId  Int?
  regionCode        String? // Khu vực (DP, LP, AD, KLH)
  allocationDate    DateTime? // Ngày phân bổ
  conditionStatus   String? // Tình trạng (Bình thường / Hỏng...)
  transferHistory   String?         @db.Text // Lịch sử điều chuyển
  manufacturer      String? // NHÃN HIỆU (KOBELCO, SUMITOMO, HOWO, HINO...)
  origin            String? // XUẤT XỨ (NHẬT BẢN, HÀN QUỐC, TRUNG QUỐC, MỸ...)
  manufactureYear   Int? // NĂM SX
  modelName         String? // MODEL (SK200-08, 6140B, HD270...)
  powerHp           String? // CÔNG SUẤT (140HP, 150 KW, 110cc...)
  frameNumber       String? // Số khung
  engineNumber      String? // Số máy
