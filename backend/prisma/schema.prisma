  @@index([managerUserId, effectiveFrom, effectiveTo], map: "manager_assignment_user_effective_idx")
  @@index([legacyCatalogId])
  @@map("management_unit_manager_assignments")
}

model DriverManagementAssignment {
  id               Int       @id @default(autoincrement())
  driverId         Int
  managementUnitId Int
  teamUnitId       Int?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  reason           String?   @db.Text
  assignedById     Int
  createdAt        DateTime  @default(now())

  driver         DriverProfile         @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  managementUnit DriverManagementUnit  @relation("DriverManagementOwnerUnit", fields: [managementUnitId], references: [id], onDelete: Restrict)
  teamUnit       DriverManagementUnit? @relation("DriverManagementTeamUnit", fields: [teamUnitId], references: [id], onDelete: Restrict)
  assignedBy     User                  @relation("DriverManagementAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([driverId, effectiveFrom, effectiveTo], map: "driver_mgmt_assign_driver_eff_idx")
  @@index([managementUnitId, effectiveTo])
  @@index([teamUnitId, effectiveTo])
  @@map("driver_management_assignments")
}

model DriverManagementAccessScope {
  id                  Int      @id @default(autoincrement())
  userId              Int
  complexCode         String
  managementUnitId    Int?
  canManageCatalog    Boolean  @default(false)
  canAssignDrivers    Boolean  @default(false)
  isManagerProjection Boolean  @default(false)
  grantedById         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user           User                  @relation("DriverManagementScopeUser", fields: [userId], references: [id], onDelete: Cascade)
  managementUnit DriverManagementUnit? @relation(fields: [managementUnitId], references: [id], onDelete: Cascade)
  grantedBy      User                  @relation("DriverManagementScopeGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, complexCode, managementUnitId], map: "driver_mgmt_scope_user_comp_unit_key")
  @@index([complexCode, managementUnitId], map: "driver_mgmt_scope_comp_unit_idx")
  @@map("driver_management_access_scopes")
}

model VehicleDriverAssignment {
  id            Int                           @id @default(autoincrement())
  vehicleId     Int
  driverId      Int
  type          VehicleDriverAssignmentType
  status        VehicleDriverAssignmentStatus @default(ACTIVE)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  assignedById  Int
  reason        String?                       @db.Text
  createdAt     DateTime                      @default(now())

  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver     DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  assignedBy User          @relation("VehicleDriverAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([vehicleId, type, effectiveFrom, effectiveTo], map: "vda_vehicle_type_effective_idx")
  @@index([driverId, type, effectiveFrom, effectiveTo], map: "vda_driver_type_effective_idx")
  @@index([status])
  @@map("vehicle_driver_assignments")
}

model DriverUnavailability {
  id           Int                      @id @default(autoincrement())
  driverId     Int
  type         DriverUnavailabilityType
  status       UnavailabilityStatus     @default(PENDING)
  startAt      DateTime
  endAt        DateTime?
  reason       String?                  @db.Text
  evidenceUrl  String?                  @db.Text
  approvedById Int?
  approvedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  driver     DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  approvedBy User?         @relation("DriverUnavailabilityApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([driverId, status, startAt, endAt])
  @@map("driver_unavailability")
}

model VehicleUnavailability {
  id          Int                       @id @default(autoincrement())
  vehicleId   Int
  type        VehicleUnavailabilityType
  status      UnavailabilityStatus      @default(APPROVED)
  startAt     DateTime
  endAt       DateTime?
  reason      String?                   @db.Text
  createdById Int
  cancelledAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User    @relation("VehicleUnavailabilityActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([vehicleId, status, startAt, endAt])
  @@map("vehicle_unavailability")
}

model SchedulingPolicy {
  unit                    Unit     @id
  vehicleBufferMinutes    Int      @default(0)
  driverBufferMinutes     Int      @default(0)
  timezone                String   @default("Asia/Phnom_Penh")
  completionPhotoCount    Int      @default(1)
  acceptGraceMinutes      Int      @default(15)
  reportOpenBeforeMinutes Int      @default(60)
  reportGraceMinutes      Int      @default(15)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("scheduling_policies")
}

model OperationalWorkOrder {
  id                     Int                @id @default(autoincrement())
  type                   WorkOrderType
  unit                   Unit
  managementUnitId       Int?
  category               WorkOrderCategory
  sourceType             DispatchSourceType @default(MANUAL)
  assignmentMode         WorkAssignmentMode @default(FIXED_ASSIGNMENT)
  status                 WorkOrderStatus    @default(DRAFT)
  plannedStartAt         DateTime
  plannedEndAt           DateTime
  complexCode            String?
  complexName            String?
  enterpriseCode         String?
  enterpriseName         String?
  farmCode               String?
  farmName               String?
  workLocationId         Int?
  workLocationText       String?
  workLocationNotes      String?            @db.Text
  workLat                Float?
  workLng                Float?
  jobCode                String?
  jobName                String
  jobDescription         String?            @db.Text
  shift                  String             @default("CA_NGAY")
  priority               WorkPriority       @default(NORMAL)
  targetQuantity         Float              @default(0)
  targetUnit             String?
  completedQuantity      Float              @default(0)
  expectedCompletedAt    DateTime?
  actualCompletedAt      DateTime?
  completionReportedById Int?
  completionApprovedById Int?
  completionApprovedAt   DateTime?
  delayReason            WorkDelayReason?
  delayReasonNote        String?            @db.Text
  requestedVehicleTypeId Int?
  requestedVehicleCount  Int                @default(1)
  categoryDetails        Json?
  notes                  String?            @db.Text
  version                Int                @default(1)
  dispatchOrderId        Int?               @unique
  transportOrderId       Int?               @unique
  internalFeedTripId     Int?               @unique
  createdById            Int
  approvedById           Int?
  submittedAt            DateTime?
  approvedAt             DateTime?
  closedAt               DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  dispatchOrder        DispatchOrder?          @relation(fields: [dispatchOrderId], references: [id], onDelete: Restrict)
  transportOrder       TransportOrder?         @relation(fields: [transportOrderId], references: [id], onDelete: Restrict)
  internalFeedTrip     InternalFeedTrip?       @relation(fields: [internalFeedTripId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy           User?                   @relation("WorkOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  workLocation         OperationalLocation?    @relation("WorkOrderLocation", fields: [workLocationId], references: [id], onDelete: SetNull)
  requestedVehicleType VehicleType?            @relation("RequestedVehicleType", fields: [requestedVehicleTypeId], references: [id], onDelete: SetNull)
  managementUnit       DriverManagementUnit?   @relation(fields: [managementUnitId], references: [id], onDelete: SetNull)
  vehicleAssignments   WorkVehicleAssignment[]
  driverAssignments    WorkDriverAssignment[]
  executionSegments    WorkExecutionSegment[]
  evidence             WorkEvidence[]
  acceptances          WorkAcceptance[]
  events               WorkOrderEvent[]
  kpiEvents            DriverKpiEvent[]
  journeyLegs          WorkJourneyLeg[]
  dailyProgress        WorkDailyProgress[]
  dailyDispatchOrders  DispatchOrder[]         @relation("DailyDispatchWorkTask")
  completionReportedBy User?                   @relation("WorkCompletionReporter", fields: [completionReportedById], references: [id], onDelete: SetNull)
  completionApprovedBy User?                   @relation("WorkCompletionApprover", fields: [completionApprovedById], references: [id], onDelete: SetNull)
  sosAlerts            DriverSosAlert[]
  dailyReports         DailyReport[]

  @@index([unit, status, plannedStartAt, plannedEndAt], map: "owo_unit_status_planned_window_idx")
  @@index([managementUnitId])
  @@index([type, status])
  @@index([category, sourceType])
  @@index([complexCode, enterpriseCode, farmCode])
  @@index([workLocationId])
  @@index([requestedVehicleTypeId])
  @@index([expectedCompletedAt, status])
  @@map("operational_work_orders")
}

model WorkVehicleAssignment {
  id           Int                  @id @default(autoincrement())
  workOrderId  Int
  vehicleId    Int
  status       WorkAssignmentStatus @default(ASSIGNED)
  startAt      DateTime
  endAt        DateTime?
  assignedById Int
  reason       String?              @db.Text
  createdAt    DateTime             @default(now())

  workOrder         OperationalWorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedBy        User                   @relation("WorkVehicleAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  executionSegments WorkExecutionSegment[]

  @@index([workOrderId, status])
  @@index([vehicleId, status, startAt, endAt])
  @@map("work_vehicle_assignments")
}

model WorkDriverAssignment {
  id           Int                  @id @default(autoincrement())
  workOrderId  Int
  driverId     Int
  status       WorkAssignmentStatus @default(ASSIGNED)
  startAt      DateTime
  endAt        DateTime?
  assignedById Int
  acceptedAt   DateTime?
  reportedAt   DateTime?
  reasonCode   String?
  reason       String?              @db.Text
  evidenceUrl  String?              @db.Text
  createdAt    DateTime             @default(now())

  workOrder         OperationalWorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  driver            DriverProfile          @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  assignedBy        User                   @relation("WorkDriverAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  executionSegments WorkExecutionSegment[]

  @@index([workOrderId, status])
  @@index([driverId, status, startAt, endAt])
  @@map("work_driver_assignments")
}

model WorkExecutionSegment {
  id                  Int               @id @default(autoincrement())
  workOrderId         Int
  vehicleAssignmentId Int?
  driverAssignmentId  Int?
  vehicleId           Int
  driverId            Int
  startedAt           DateTime
  endedAt             DateTime?
  workDate            DateTime          @db.Date
  status              WorkSessionStatus @default(ACTIVE)
  grossMinutes        Int               @default(0)
  breakMinutes        Int               @default(0)
  pauseMinutes        Int               @default(0)
  workingMinutes      Int               @default(0)
  startOdoKm          Float?
  endOdoKm            Float?
  startMachineHours   Float?
  endMachineHours     Float?
  startLat            Float?
  startLng            Float?
  endLat              Float?
  endLng              Float?
  quantity            Float?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workOrder         OperationalWorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  vehicleAssignment WorkVehicleAssignment? @relation(fields: [vehicleAssignmentId], references: [id], onDelete: SetNull)
  driverAssignment  WorkDriverAssignment?  @relation(fields: [driverAssignmentId], references: [id], onDelete: SetNull)
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver            DriverProfile          @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  kpiEvents         DriverKpiEvent[]
  breaks            WorkBreakSession[]
  pauses            WorkPauseSession[]
  sosAlerts         DriverSosAlert[]

  @@index([workOrderId, startedAt, endedAt])
  @@index([vehicleId, startedAt, endedAt])
  @@index([driverId, startedAt, endedAt])
  @@index([driverId, status])
  @@index([driverId, workDate])
  @@index([workOrderId, workDate])
  @@map("work_execution_segments")
}

model WorkBreakSession {
  id              Int           @id @default(autoincrement())
  workSessionId   Int
  type            WorkBreakType @default(OTHER)
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int           @default(0)
  note            String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workSession WorkExecutionSegment @relation(fields: [workSessionId], references: [id], onDelete: Restrict)

  @@index([workSessionId, startedAt])
  @@index([workSessionId, endedAt])
  @@map("work_break_sessions")
}

model WorkPauseSession {
  id              Int             @id @default(autoincrement())
  workSessionId   Int
  reason          WorkPauseReason
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int             @default(0)
  note            String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workSession WorkExecutionSegment @relation(fields: [workSessionId], references: [id], onDelete: Restrict)

  @@index([workSessionId, startedAt])
  @@index([workSessionId, endedAt])
  @@map("work_pause_sessions")
}

model WorkDailyProgress {
  id                     Int      @id @default(autoincrement())
  workOrderId            Int
  progressDate           DateTime @db.Date
  quantityToday          Float    @default(0)
  accumulatedQuantity    Float    @default(0)
  overallProgressPercent Float    @default(0)
  description            String?  @db.Text
  note                   String?  @db.Text
  evidenceUrls           Json?
  reportedById           Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workOrder  OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  reportedBy User                 @relation("WorkDailyProgressReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  @@unique([workOrderId, progressDate])
  @@index([reportedById, progressDate])
  @@map("work_daily_progress")
}

model DailyReport {
  id                 Int                       @id @default(autoincrement())
  dispatchOrderId    Int                       @unique
  workOrderId        Int
  originalDriverId   Int
  reportDate         DateTime                  @db.Date
  status             DailyReportStatus         @default(NOT_OPEN)
  quantityToday      Float                     @default(0)
  unit               String?
  startMachineHours  Float?
  endMachineHours    Float?
  startOdoKm         Float?
  endOdoKm           Float?
  fuelLiters         Float?
  evidenceUrls       Json?
  note               String?                   @db.Text
  workCompleted      Boolean                   @default(false)
  reportStartedAt    DateTime?
  reportSubmittedAt  DateTime?
  reportDelayMinutes Int                       @default(0)
  submittedByType    DailyReportSubmitterType?
  submittedByUserId  Int?
  managerReason      String?                   @db.Text
  revisionReason     String?                   @db.Text
  reviewedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  dispatchOrder  DispatchOrder        @relation(fields: [dispatchOrderId], references: [id], onDelete: Restrict)
  workOrder      OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  originalDriver User                 @relation("DailyReportDriver", fields: [originalDriverId], references: [id], onDelete: Restrict)
  submittedBy    User?                @relation("DailyReportSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([workOrderId, reportDate])
  @@index([originalDriverId, status, reportDate])
  @@index([status, reportDate])
  @@map("daily_reports")
}

model WorkEvidence {
  id             Int                    @id @default(autoincrement())
  workOrderId    Int
  type           WorkEvidenceType
  url            String                 @db.Text
  capturedAt     DateTime
  lat            Float?
  lng            Float?
  checksum       String?
  locationStatus EvidenceLocationStatus @default(LOCATION_UNKNOWN)
  createdById    Int
  createdAt      DateTime               @default(now())

  workOrder OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workOrderId, type, capturedAt])
  @@map("work_evidence")
}

model OperationalLocation {
  id              Int                     @id @default(autoincrement())
  code            String                  @unique
  name            String
  type            OperationalLocationType
  unit            Unit?
  complexCode     String?
  enterpriseCode  String?
  farmCode        String?
  regionName      String?
  address         String?
  lat             Float?
  lng             Float?
  geofenceRadiusM Int                     @default(300)
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  depotVehicles               Vehicle[]              @relation("VehicleHomeDepot")
  dispatchOrigins             DispatchOrder[]        @relation("DispatchOriginLocation")
  dispatchDestinations        DispatchOrder[]        @relation("DispatchDestinationLocation")
  transportOrigins            TransportOrder[]       @relation("TransportOriginLocation")
  transportDestinations       TransportOrder[]       @relation("TransportDestinationLocation")
  transportReturnOrigins      TransportOrder[]       @relation("TransportReturnOriginLocation")
  transportReturnDestinations TransportOrder[]       @relation("TransportReturnDestinationLocation")
  journeyOrigins              WorkJourneyLeg[]       @relation("JourneyOriginLocation")
  journeyDestinations         WorkJourneyLeg[]       @relation("JourneyDestinationLocation")
  workOrders                  OperationalWorkOrder[] @relation("WorkOrderLocation")
  managementUnits             DriverManagementUnit[] @relation("ManagementUnitMainDepot")

  @@unique([name, complexCode])
  @@index([type, active])
  @@index([unit])
  @@index([complexCode])
  @@index([enterpriseCode])
  @@index([farmCode])
  @@map("operational_locations")
}

model WorkJourneyLeg {
  id                    Int              @id @default(autoincrement())
  workOrderId           Int
  sequence              Int
  type                  JourneyLegType
  status                JourneyLegStatus @default(PLANNED)
  originLocationId      Int?
  destinationLocationId Int?
  originName            String
  destinationName       String
  cargoName             String?
  tonnage               Float?
  isEmpty               Boolean          @default(false)
  startedAt             DateTime?
  pickupAt              DateTime?
  loadingAt             DateTime?
  departedAt            DateTime?
  deliveryAt            DateTime?
  unloadingAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workOrder           OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  originLocation      OperationalLocation? @relation("JourneyOriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation OperationalLocation? @relation("JourneyDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@unique([workOrderId, sequence])
  @@index([workOrderId, status])
  @@index([originLocationId])
  @@index([destinationLocationId])
  @@map("work_journey_legs")
}

model WorkAcceptance {
  id           Int                  @id @default(autoincrement())
  workOrderId  Int
  status       WorkAcceptanceStatus @default(PENDING)
  submittedAt  DateTime             @default(now())
  reviewedById Int?
  reviewedAt   DateTime?
  reason       String?              @db.Text
  createdAt    DateTime             @default(now())

  workOrder  OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  reviewedBy User?                @relation("WorkAcceptanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([workOrderId, status])
  @@map("work_acceptances")
}

model WorkOrderEvent {
  id          Int              @id @default(autoincrement())
  workOrderId Int
  actorId     Int
  action      String
  oldStatus   WorkOrderStatus?
  newStatus   WorkOrderStatus?
  payload     Json?
  reason      String?          @db.Text
  occurredAt  DateTime         @default(now())

  workOrder OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor     User                 @relation("WorkOrderEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workOrderId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("work_order_events")
}

model DriverKpiEvent {
  id                 Int                @id @default(autoincrement())
  driverId           Int
  workOrderId        Int
  executionSegmentId Int?
  type               DriverKpiEventType
  decision           KpiDecision        @default(UNDECIDED)
  distanceKm         Float              @default(0)
  machineHours       Float              @default(0)
  quantity           Float              @default(0)
  fuelLiters         Float?
  reasonCode         String?
  payload            Json?
  occurredAt         DateTime           @default(now())

  driver           DriverProfile         @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  workOrder        OperationalWorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  executionSegment WorkExecutionSegment? @relation(fields: [executionSegmentId], references: [id], onDelete: SetNull)

  @@index([driverId, occurredAt])
  @@index([workOrderId, type])
  @@map("driver_kpi_events")
}

// ==========================================
// 3. COMMON CATALOGS & SYSTEM ADMIN DATA
// ==========================================

enum CatalogType {
  COMPLEX
  REGION
  DEPARTMENT
  ENTERPRISE
  FARM
  TEAM
  PLOT
  LAND_PARCEL
  VEHICLE_CATEGORY
  JOB_TYPE
  POSITION
  JOB_ITEM
  ORDER_TYPE
  ROUTE
  CONSTRUCTION_SITE
  SPARE_PART
  TECHNICAL_QUOTA
  CG_MANAGER
  VEHICLE_ORIGIN
  PURCHASE_CONDITION
  SUPPLIER
  COMPANY_OWNER
}

model CatalogItem {
  id                String      @id
  code              String
  name              String
  normalizedKey     String?
  type              CatalogType
  parentCode        String?
  parentName        String?
  enterpriseName    String?
  farmName          String?
  plotStatus        String?
  routeFlowType     RouteType?
  returnOrigin      String?
  returnDestination String?
  returnCargoName   String?
  returnTonnage     Float?
  systemId          String?
  address           String?
  managerName       String?
  phone             String?
  areaHa            Float?
  status            String      @default("HOAT_DONG")
  description       String?     @db.Text
  createdUser       String?     @default("admin")
  createdDate       String?
  updatedUser       String?     @default("admin")
  updatedDate       String?
  confirmedUser     String?
  confirmedDate     String?
  deletedUser       String?
  deletedDate       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([type])
  @@index([code])
  @@index([parentCode])
  @@index([status])
  @@unique([type, normalizedKey])
  @@map("catalogs")
}

model CompanyEntity {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  address         String
  field           String
  businessLicense String
  charterCapital  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("companies")
}

model EmployeeRecord {
  id                    Int      @id @default(autoincrement())
  empCode               String   @unique
  fullName              String
  businessUnit          String?
  complex               String?
  enterprise            String?
  farm                  String?
  team                  String?
  position              String?
  licenseClass          String?
  licenseNumber         String?
  licenseExpiryDate     String?
  healthCheckExpiryDate String?
  status                String   @default("Hoạt động")
  username              String?
  phone                 String?
  email                 String?
  joinedDate            String?
  idCardNumber          String?
  idCardIssueDate       String?
  idCardIssuePlace      String?
  taxCode               String?
  bankAccount           String?
  bankName              String?
  salaryGrade           String?
  baseSalary            Float?
  coefficients          Float?
  insuranceSalary       Float?
  allowancesJson        Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("employees")
}

model PersonnelRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  complex    String?
  enterprise String?
  farm       String?
  team       String?
  position   String?
  status     String   @default("Hoạt động")
  creator    String?  @default("admin")
  createdAt  DateTime @default(now())
  updater    String?  @default("admin")
  updatedAt  DateTime @updatedAt

  @@map("personnel_partners")
}
