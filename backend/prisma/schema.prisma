  operationDomain         VehicleOperationalDomain?
  productionOrderId       Int?
  sosAlertId              Int?                      @unique
  generationKey           String?                   @unique
  implementId             Int?
  vehicleId               Int?
  driverId                Int?
  workOrderId             Int?
  previousDispatchOrderId Int?                      @unique
  departureTime           DateTime?
  plannedEndTime          DateTime?
  scheduledStartAt        DateTime?
  scheduledEndAt          DateTime?
  workDurationMinutes     Int                       @default(0)
  breakDurationMinutes    Int                       @default(0)
  acceptGraceMinutes      Int                       @default(15)
  acceptDelayMinutes      Int                       @default(0)
  acceptStatus            DispatchAcceptStatus      @default(NOT_ACCEPTED)
  reportOpenAt            DateTime?
  reportDeadlineAt        DateTime?
  actualDepartureTime     DateTime?
  actualStartTime         DateTime?
  actualCompletedTime     DateTime?
  returnTime              DateTime?
  approvedById            Int?
  assignedById            Int?
  acceptedById            Int?
  submittedAt             DateTime?
  approvedAt              DateTime?
  assignedAt              DateTime?
  driverAcceptedAt        DateTime?
  acceptedAt              DateTime?
  closedAt                DateTime?
  cancelledAt             DateTime?
  rejectionReason         String?                   @db.Text
  legacyVehicle           String?
  legacyDriver            String?
  legacyImplement         String?
  status                  DispatchStatus            @default(DRAFT)
  isDelayed               Boolean                   @default(false)
  notes                   String?                   @db.Text
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  // Quan hệ
  requester             User                    @relation("RequesterDispatch", fields: [requesterId], references: [id], onDelete: Cascade)
  originLocation        OperationalLocation?    @relation("DispatchOriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation   OperationalLocation?    @relation("DispatchDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  vehicle               Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver                User?                   @relation("DriverDispatch", fields: [driverId], references: [id], onDelete: SetNull)
  productionOrder       ProductionOrder?        @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  sosAlert              DriverSosAlert?         @relation("SosRescueDispatch", fields: [sosAlertId], references: [id], onDelete: SetNull)
  implement             AgriculturalImplement?  @relation(fields: [implementId], references: [id], onDelete: SetNull)
  approvedBy            User?                   @relation("DispatchApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assignedBy            User?                   @relation("DispatchAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  acceptedBy            User?                   @relation("DispatchAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  confirmations         OperationConfirmation[]
  operationalWorkOrder  OperationalWorkOrder?
  workTask              OperationalWorkOrder?   @relation("DailyDispatchWorkTask", fields: [workOrderId], references: [id], onDelete: Restrict)
  previousDispatchOrder DispatchOrder?          @relation("DispatchOrderSequence", fields: [previousDispatchOrderId], references: [id], onDelete: SetNull)
  nextDispatchOrders    DispatchOrder[]         @relation("DispatchOrderSequence")
  dailyReport           DailyReport?

  @@index([unit])
  @@index([status])
  @@index([operationDomain])
  @@index([vehicleId])
  @@index([driverId])
  @@index([workOrderId, scheduledStartAt])
  @@index([previousDispatchOrderId])
  @@index([reportDeadlineAt, status])
  @@index([productionOrderId])
  @@index([implementId])
  @@index([departureTime, plannedEndTime])
  @@index([originLocationId])
  @@index([destinationLocationId])
  @@map("dispatch_orders")
}

model TransportOrder {
