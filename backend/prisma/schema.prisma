/// Mobile refresh sessions are device-bound. The refresh token itself is never persisted.
model MobileSession {
  id               Int       @id @default(autoincrement())
  driverId         Int
  deviceId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, deviceId])
  @@index([expiresAt])
  @@map("mobile_sessions")
}

/// Immutable mobile commands. `eventId` makes retries safe when the app reconnects.
model MobileSyncEvent {
  id             Int                   @id @default(autoincrement())
  eventId        String                @unique @db.VarChar(36)
  deviceId       String
  driverId       Int
  orderType      String?
  orderId        Int?
  eventType      String
  sequenceNumber Int
  occurredAt     DateTime
  baseVersion    Int?
  payload        Json
  result         Json?
  status         MobileSyncEventStatus @default(PROCESSED)
  createdAt      DateTime              @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, occurredAt])
  @@index([deviceId, sequenceNumber])
  @@index([orderType, orderId])
  @@map("mobile_sync_events")
}

model OperationConfirmation {
  id               Int                         @id @default(autoincrement())
  code             String                      @unique
  type             OperationConfirmationType
  status           OperationConfirmationStatus @default(PENDING)
  dispatchOrderId  Int?
  transportOrderId Int?
  grossWeightTons  Float?
  tareWeightTons   Float?
  netWeightTons    Float?
  measuredAreaHa   Float?
  machineHours     Float?
  routeLocation    String?
  createdById      Int
  confirmedById    Int?
  confirmedAt      DateTime?
