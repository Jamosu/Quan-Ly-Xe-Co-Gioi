  fuelTickets            FuelDispenseTicket[]
  maintenanceRecords     MaintenanceRecord[]
  maintenanceOccurrences MaintenanceOccurrence[]
  bdc1Logs               Bdc1Log[]
  owedPartNotes          WorkshopOwedPartNote[]
