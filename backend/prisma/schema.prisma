  updatedAt    DateTime                 @updatedAt

  driver       DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  approvedBy   User?         @relation("DriverUnavailabilityApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([driverId, status, startAt, endAt])
  @@map("driver_unavailability")
}

model VehicleUnavailability {
  id          Int                       @id @default(autoincrement())
  vehicleId   Int
  type        VehicleUnavailabilityType
  status      UnavailabilityStatus      @default(APPROVED)
  startAt     DateTime
  endAt       DateTime?
  reason      String?                   @db.Text
  createdById Int
  cancelledAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy   User    @relation("VehicleUnavailabilityActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([vehicleId, status, startAt, endAt])
  @@map("vehicle_unavailability")
}

model SchedulingPolicy {
  unit                 Unit     @id
  vehicleBufferMinutes Int      @default(0)
  driverBufferMinutes  Int      @default(0)
  timezone             String   @default("Asia/Phnom_Penh")
  completionPhotoCount Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("scheduling_policies")
}

model OperationalWorkOrder {
  id                 Int                @id @default(autoincrement())
  type               WorkOrderType
  unit               Unit
  assignmentMode     WorkAssignmentMode @default(FIXED_ASSIGNMENT)
  status             WorkOrderStatus    @default(DRAFT)
  plannedStartAt     DateTime
  plannedEndAt       DateTime
  version            Int                @default(1)
  dispatchOrderId    Int?               @unique
  transportOrderId   Int?               @unique
  internalFeedTripId Int?               @unique
  createdById        Int
  approvedById       Int?
  submittedAt        DateTime?
  approvedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?            @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  dispatchOrder      DispatchOrder?   @relation(fields: [dispatchOrderId], references: [id], onDelete: Restrict)
  transportOrder     TransportOrder?  @relation(fields: [transportOrderId], references: [id], onDelete: Restrict)
  internalFeedTrip   InternalFeedTrip? @relation(fields: [internalFeedTripId], references: [id], onDelete: Restrict)
  createdBy          User              @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?             @relation("WorkOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  vehicleAssignments WorkVehicleAssignment[]
  driverAssignments  WorkDriverAssignment[]
  executionSegments  WorkExecutionSegment[]
  evidence           WorkEvidence[]
  acceptances        WorkAcceptance[]
  events             WorkOrderEvent[]
  kpiEvents          DriverKpiEvent[]

  @@index([unit, status, plannedStartAt, plannedEndAt], map: "owo_unit_status_planned_window_idx")
  @@index([type, status])
  @@map("operational_work_orders")
}

model WorkVehicleAssignment {
  id          Int                  @id @default(autoincrement())
  workOrderId Int
  vehicleId   Int
  status      WorkAssignmentStatus @default(ASSIGNED)
  startAt     DateTime
  endAt       DateTime?
  assignedById Int
  reason      String?              @db.Text
  createdAt   DateTime             @default(now())

  workOrder   OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedBy  User                 @relation("WorkVehicleAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  executionSegments WorkExecutionSegment[]

  @@index([workOrderId, status])
  @@index([vehicleId, status, startAt, endAt])
  @@map("work_vehicle_assignments")
}

model WorkDriverAssignment {
  id          Int                  @id @default(autoincrement())
  workOrderId Int
  driverId    Int
  status      WorkAssignmentStatus @default(ASSIGNED)
  startAt     DateTime
  endAt       DateTime?
  assignedById Int
  acceptedAt  DateTime?
  reportedAt  DateTime?
  reasonCode  String?
  reason      String?              @db.Text
  evidenceUrl String?              @db.Text
  createdAt   DateTime             @default(now())

  workOrder   OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  driver      DriverProfile        @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  assignedBy  User                 @relation("WorkDriverAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  executionSegments WorkExecutionSegment[]

  @@index([workOrderId, status])
  @@index([driverId, status, startAt, endAt])
  @@map("work_driver_assignments")
}

model WorkExecutionSegment {
  id                  Int       @id @default(autoincrement())
  workOrderId         Int
  vehicleAssignmentId Int?
  driverAssignmentId  Int?
  vehicleId           Int
  driverId            Int
  startedAt           DateTime
  endedAt             DateTime?
  startOdoKm          Float?
  endOdoKm            Float?
  startMachineHours   Float?
  endMachineHours     Float?
  startLat            Float?
  startLng            Float?
  endLat              Float?
  endLng               Float?
  quantity            Float?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrder           OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  vehicleAssignment   WorkVehicleAssignment? @relation(fields: [vehicleAssignmentId], references: [id], onDelete: SetNull)
  driverAssignment    WorkDriverAssignment?  @relation(fields: [driverAssignmentId], references: [id], onDelete: SetNull)
  vehicle             Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver              DriverProfile          @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  kpiEvents           DriverKpiEvent[]

  @@index([workOrderId, startedAt, endedAt])
  @@index([vehicleId, startedAt, endedAt])
  @@index([driverId, startedAt, endedAt])
  @@map("work_execution_segments")
}

model WorkEvidence {
  id          Int              @id @default(autoincrement())
  workOrderId Int
  type        WorkEvidenceType
  url         String           @db.Text
  capturedAt  DateTime
  lat         Float?
  lng         Float?
  checksum    String?
  createdById Int
  createdAt   DateTime         @default(now())

  workOrder   OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workOrderId, type, capturedAt])
  @@map("work_evidence")
}

model WorkAcceptance {
  id           Int                  @id @default(autoincrement())
  workOrderId  Int
  status       WorkAcceptanceStatus @default(PENDING)
  submittedAt  DateTime             @default(now())
  reviewedById Int?
  reviewedAt   DateTime?
  reason       String?              @db.Text
  createdAt    DateTime             @default(now())

  workOrder    OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  reviewedBy   User?                @relation("WorkAcceptanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([workOrderId, status])
  @@map("work_acceptances")
}

model WorkOrderEvent {
  id          Int      @id @default(autoincrement())
  workOrderId Int
  actorId     Int
  action      String
  oldStatus   WorkOrderStatus?
  newStatus   WorkOrderStatus?
  payload     Json?
  reason      String?  @db.Text
  occurredAt  DateTime @default(now())

  workOrder   OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor       User                 @relation("WorkOrderEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workOrderId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("work_order_events")
}

model DriverKpiEvent {
  id                 Int                @id @default(autoincrement())
  driverId           Int
  workOrderId        Int
  executionSegmentId Int?
  type               DriverKpiEventType
  decision           KpiDecision        @default(UNDECIDED)
  distanceKm         Float              @default(0)
  machineHours       Float              @default(0)
  quantity           Float              @default(0)
  fuelLiters         Float?
  reasonCode         String?
  payload            Json?
  occurredAt         DateTime           @default(now())

  driver             DriverProfile       @relation(fields: [driverId], references: [userId], onDelete: Restrict)
  workOrder          OperationalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  executionSegment   WorkExecutionSegment? @relation(fields: [executionSegmentId], references: [id], onDelete: SetNull)

  @@index([driverId, occurredAt])
  @@index([workOrderId, type])
  @@map("driver_kpi_events")
}

// ==========================================
// 3. COMMON CATALOGS & SYSTEM ADMIN DATA
// ==========================================

enum CatalogType {
  COMPLEX
  REGION
  DEPARTMENT
  ENTERPRISE
  FARM
  TEAM
  PLOT
  LAND_PARCEL
  VEHICLE_CATEGORY
  JOB_TYPE
}

model CatalogItem {
  id             String      @id
  code           String
  name           String
  type           CatalogType
  parentCode     String?
  parentName     String?
  enterpriseName String?
  farmName       String?
  plotStatus     String?
  systemId       String?
  address        String?
  managerName    String?
  phone          String?
  areaHa         Float?
  status         String      @default("HOAT_DONG")
  description    String?     @db.Text
  createdUser    String?     @default("admin")
  createdDate    String?
  updatedUser    String?     @default("admin")
  updatedDate    String?
  confirmedUser  String?
  confirmedDate  String?
  deletedUser    String?
  deletedDate    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([type])
  @@index([code])
  @@index([parentCode])
  @@index([status])
  @@map("catalogs")
}

model CompanyEntity {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  address         String
  field           String
  businessLicense String
  charterCapital  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("companies")
}

model EmployeeRecord {
  id                    Int      @id @default(autoincrement())
  empCode               String   @unique
  fullName              String
  businessUnit          String?
  complex               String?
  enterprise            String?
  farm                  String?
  team                  String?
  position              String?
  licenseClass          String?
  licenseNumber         String?
  licenseExpiryDate     String?
  healthCheckExpiryDate String?
  status                String   @default("Hoạt động")
  username              String?
  phone                 String?
  email                 String?
  joinedDate            String?
  idCardNumber          String?
  idCardIssueDate       String?
  idCardIssuePlace      String?
  taxCode               String?
  bankAccount           String?
  bankName              String?
  salaryGrade           String?
  baseSalary            Float?
  coefficients          Float?
  insuranceSalary       Float?
  allowancesJson        Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("employees")
}

model PersonnelRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  complex    String?
  enterprise String?
  farm       String?
  team       String?
  position   String?
  status     String   @default("Hoạt động")
  creator    String?  @default("admin")
  createdAt  DateTime @default(now())
  updater    String?  @default("admin")
  updatedAt  DateTime @updatedAt

  @@map("personnel_partners")
}
