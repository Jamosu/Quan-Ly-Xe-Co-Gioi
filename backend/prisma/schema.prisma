enum DriverLicenseClass {
  // --- Nhóm mô tô & xe 3 bánh ---
  HANG_A // Hạng A: Mô tô >125CC, xe 3 bánh

  // --- Nhóm xe ô tô hạng nhẹ & máy cày (≤3.5T, ô tô con <9 chỗ) ---
  HANG_B1 // Hạng B1: Xe con, xe tải ≤3.5T (số tự động, không lái thuê)
  HANG_B2 // Hạng B2: Máy cày, ô tô con <9 chỗ, xe tải ≤3.5T

  // --- Nhóm xe tải nặng (>3.5T) ---
  HANG_C // Hạng C: Xe tải >3.5T, xe chuyên dùng hạng nặng

  // --- Nhóm đầu kéo, rơ-moóc (mở rộng C) ---
  HANG_CE // Hạng CE: Đầu kéo container, xe đầu kéo kéo rơ-moóc

  // --- Nhóm xe chở người ---
  HANG_D1 // Hạng D1: Xe chở người từ 10-20 chỗ (≤20 chỗ)
  HANG_D2 // Hạng D2: Xe chở người >20 chỗ (xe buýt, xe khách lớn)
}

