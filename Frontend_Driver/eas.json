{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_API_BASE_URL": "http://10.23.2.228:3001/api" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
